APP_NAME=The-Ledrix-Team
APP_ENV=local
APP_KEY=base64:Igur8eLBNyP5HurBBo2POi1v+5DriQGbAbn3Dr/CFW8=
APP_DEBUG=true
APP_TIMEZONE=UTC
# Local artisan serve: http://127.0.0.1:8000  |  XAMPP vhost: http://ledrix.co
APP_URL=http://127.0.0.1:8000

# Google Search Console verification (optional — paste content value from GSC)
GOOGLE_SITE_VERIFICATION=

# Super Admin Data 
SUPER_ADMIN_NAME=LedrixOwner
SUPER_ADMIN_EMAIL=owner@ledrix.app
SUPER_ADMIN_PASSWORD=admin123



UPLOAD_MAX_FILESIZE=20M
POST_MAX_SIZE=25M

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug


# Super Admin Database
DB_SUPER_CONNECTION=central
DB_SUPER_HOST=127.0.0.1
DB_SUPER_PORT=3306
DB_SUPER_DATABASE=ledrix_central
DB_SUPER_USERNAME=root
DB_SUPER_PASSWORD=
# Default CRM Database (local tenant db)
DB_CONNECTION=primary
DB_PRIMARY_HOST=127.0.0.1
DB_PRIMARY_PORT=3306
DB_PRIMARY_DATABASE=ledrix_primary
DB_PRIMARY_USERNAME=root
DB_PRIMARY_PASSWORD=


SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# queue jobs — use database (or redis) in production; sync is fine for local dev only
QUEUE_CONNECTION=database

# Mail — use smtp in production (log driver writes to storage/logs only)
MAIL_MAILER=smtp
MAIL_HOST=mail.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@ledrix.co"
MAIL_FROM_NAME="${APP_NAME}"


CACHE_STORE=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


BROADCAST_DRIVER=pusher
PUSHER_APP_ID=12345678910
PUSHER_APP_KEY=abcdefghijklmnopqrstuvwxyz
PUSHER_APP_SECRET=thisismysecretkeyhere
PUSHER_APP_CLUSTER=mt1


# Tenant subscription billing (Payoneer — separate from Stripe/PayPal used for CRM orders)
PAYONEER_RECEIVER_EMAIL=zeshaanasgharr@gmail.com
PAYONEER_RECEIVER_NAME="Zeeshan Asghar"
PAYONEER_CURRENCY=USD
PAYONEER_GRACE_DAYS=7
PAYONEER_TRIAL_REMINDER_DAYS=3

# JazzCash Merchant Gateway (tenant subscriptions — PKR only)
# Sandbox signup: https://sandbox.jazzcash.com.pk/MerchantDashboard/
# If unset, sandbox demo credentials from JazzCash docs are used automatically.
JAZZCASH_SANDBOX=true
JAZZCASH_MERCHANT_ID=00127801
JAZZCASH_PASSWORD=0123456789
JAZZCASH_INTEGRITY_SALT=0123456789
JAZZCASH_RETURN_URL=
JAZZCASH_CURRENCY=PKR
JAZZCASH_USD_TO_PKR_RATE=280
JAZZCASH_TRIAL_REMINDER_DAYS=3
JAZZCASH_GRACE_DAYS=7

# PayFast Pakistan — automated PKR payments (recommended for production)
# Sign up: https://gopayfast.com/ — add your Meezan bank as settlement account in their portal
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_NAME="Ledrix"
PAYFAST_SECURED_KEY=
PAYFAST_TOKEN_URL=
PAYFAST_CHECKOUT_URL=
PAYFAST_RETURN_URL=

# Stripe — automated card payments (use test keys for development)
# https://dashboard.stripe.com/test/apikeys
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Meezan Bank — tenant subscription bank transfer (Pay now on billing page)
MEEZAN_BANK_NAME="Meezan Bank"
MEEZAN_ACCOUNT_TITLE="Zeeshan Asghar"
MEEZAN_ACCOUNT_NUMBER="01580107677601"
MEEZAN_IBAN="PK76MEZN0001580107677601"          # Required for Raast QR (24-char Pakistan IBAN)
MEEZAN_BRANCH="Joffa Tower Branch-Khi"
MEEZAN_MERCHANT_CITY=Karachi
# Raast QR — Pakistan format (not EMVCo). Use dynamic or static if one fails in bank apps.
RAAST_QR_MODE=dynamic
RAAST_QR_EXPIRY_DAYS=7

BILLING_ADMIN_EMAIL=zeshanasgharr@gmail.com

# Security tets any time 
# php vendor/bin/phpunit tests/Feature/SellerPortalSecurityTest.php tests/Feature/ClientPortalSecurityTest.php --testdox


# ── Production cron (ONE line — runs queues + all scheduled tasks) ──
# Linux:  crontab -e  →  paste line from scripts/cron.example
# Windows: Task Scheduler every minute → scripts/schedule-run.ps1
# After deploy: bash scripts/post-deploy.sh  (or scripts/post-deploy.ps1)
#
# * * * * * cd /path/to/ledrix && php artisan schedule:run >> storage/logs/scheduler.log 2>&1
#
# Queues are drained every minute by the scheduler (no separate queue:work cron needed).
# Local dev without cron: set QUEUE_CONNECTION=sync  OR  run: php artisan schedule:work


# Stripe Webhook Endpoint to Use:
# To receive Stripe webhooks, you need to define a URL in your app that listens to these events. In your Stripe Dashboard:
# Go to Developers > Webhooks.
# Click on Add endpoint and enter your webhook URL, e.g., https://yourdomain.com/stripe/webhook.


# https://digiprojectmanagers.com/api/webhooks/stripe
# checkout.session.async_payment_succeeded
# checkout.session.async_payment_failed
# checkout.session.completed
# checkout.session.expired


# https://digiprojectmanagers.com/api/webhooks/stripe/dispute
# charge.dispute.created
# charge.dispute.updated
# charge.dispute.closed


# https://digiprojectmanagers.com/api/webhooks/stripe/refund
# charge.refunded
# charge.refunded.updated



# Paypal Webhook Endpoint to Use:

# https://digiprojectmanagers.com/api/webhooks/paypal
# PAYMENT.SALE.COMPLETED
# PAYMENT.SALE.PENDING
# PAYMENT.SALE.CANCELED


# https://digiprojectmanagers.com/api/webhooks/paypal/dispute
# Disputes:
# CUSTOMER.DISPUTE.CREATED
# CUSTOMER.DISPUTE.UPDATED
# CUSTOMER.DISPUTE.RESOLVED


# https://digiprojectmanagers.com/api/webhooks/paypal/refund
# Refunds:
# PAYMENT.CAPTURE.REFUNDED
# PAYMENT.SALE.REFUNDED


# Webhook endpoints — see routes/api.php /api/webhooks/*
